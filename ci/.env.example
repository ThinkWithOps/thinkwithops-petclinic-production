# Copy to ci/.env and fill in — never commit ci/.env (see .gitignore).
# scripts/ci-stack-up.sh generates strong random values for you automatically
# if ci/.env doesn't exist yet.
SONAR_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# GID that owns /var/run/docker.sock on the Docker host. Overwritten on every run
# by scripts/ci-stack-up.sh; 999 is only a placeholder so `compose config` validates.
DOCKER_GID=999

# Optional port overrides (defaults shown)
JENKINS_PORT=8090
JENKINS_AGENT_PORT=50000
SONARQUBE_PORT=9000
NEXUS_PORT=8081
