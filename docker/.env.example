# Compose project isolates this stack's containers, network and volume.
COMPOSE_PROJECT_NAME=petclinic-v1
# App image built locally; build.sh also tags it with Git version/revision.
APP_IMAGE=petclinic:local
# Bind loopback by default. Use 0.0.0.0 on a remote or cloud host so a browser on another machine can reach it.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Set https only when a proxy or load balancer in front of this stack terminates HTTPS.
# Explicit setting prevents clients spoofing an incoming X-Forwarded-Proto.
PUBLIC_SCHEME=http
# Identifier values: letters, digits, underscores; begin with a letter.
POSTGRES_DB=petclinic
POSTGRES_USER=petclinic
# setup-env.sh replaces both placeholders with separate random secrets.
# Existing .env files are preserved. Never commit this file after adding secrets.
POSTGRES_PASS=REPLACE_WITH_RANDOM_APP_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
# Heap <=65% of app limit; remaining space covers JVM native memory and /tmp.
APP_MEMORY_LIMIT=768m
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError'
POSTGRES_MEMORY_LIMIT=512m
NGINX_MEMORY_LIMIT=64m
# Docker stop grace must exceed Spring shutdown timeout.
SHUTDOWN_TIMEOUT=30s
STOP_GRACE_PERIOD=40s

# Other script-only options (export in the shell; not read from this file):
# ENV_FILE=/absolute/path/to/alternative.env
# WAIT_TIMEOUT=300              # seconds for compose up --wait
# REGISTRY=registry.example.com/team  # optional build.sh --push destination
# IMAGE_NAME=petclinic          # repository name for --push
# SOURCE=https://github.com/ThinkWithOps/thinkwithops-petclinic-production
# LICENSES=Apache-2.0           # OCI license metadata
# PUBLIC_URL=https://session-specific-viewer.example # optional external smoke test
